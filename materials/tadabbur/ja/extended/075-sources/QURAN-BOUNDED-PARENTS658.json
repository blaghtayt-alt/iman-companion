        "size": 7.086599826812744,
        "flags": 4,
        "bidi": 0,
        "char_flags": 16,
        "font": "YuMin-Medium",
        "color": 7500145,
        "alpha": 255,
        "ascender": 0.800000011920929,
        "descender": -0.20000000298023224,
        "text": "11",
        "origin": [
          606.968505859375,
          409.8188171386719
        ],
        "bbox": [
          606.968505859375,
          400.64166259765625,
          614.0550537109375,
          412.4195861816406
        ]
      }
    ],
    "requiredNotes": [
      "38:note11"
    ],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "38:76",
    "publishedBody": "彼[イブリース]は言った。「私の方が、彼よりもすぐれています。あなたは私を火炎から創造した。しかし彼のことは泥から創造した」。",
    "pages": [
      399
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "40:10",
    "publishedBody": "[その日、真理を]拒んでいた者は告げ知らされるだろう。「あなたがたに対するアッラーの嫌悪は、あなたがた同士の嫌悪よりもいっそう大きい。信仰へ呼び招かれていながら、あなたがたは拒んでいたため」。",
    "pages": [
      409
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "51:21",
    "publishedBody": "あなたがた自身の中にもまた。それでもあなたがたは、見ようとしないのか。",
    "pages": [
      456
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "51:56",
    "publishedBody": "われがジンと人間を創造したのは、われに仕えさせるために他ならない。",
    "pages": [
      457
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "56:3",
    "publishedBody": "あるものは低められ、またあるものは高められる。",
    "pages": [
      471
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "56:75",
    "publishedBody": "いいや、われは誓おう。星々のありかにかけて。",
    "pages": [
      473
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "56:76",
    "publishedBody": "本当に、それは大いなる誓い。もしあなたがたが、知ってさえいたなら。",
    "pages": [
      473
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "67:14",
    "publishedBody": "創造した御方が知らないはずがあるだろうか。細やかな御方、熟知する御方。",
    "pages": [
      500
    ],
    "noteAnchors": [
      {
        "page": 500,
        "id": "b80l0s0",
        "direction": [
          1.0,
          0.0
        ],
        "wmode": 0,
        "size": 7.086599826812744,
        "flags": 4,
        "bidi": 0,
        "char_flags": 16,
        "font": "YuMin-Medium",
        "color": 7500145,
        "alpha": 255,
        "ascender": 0.800000011920929,
        "descender": -0.20000000298023224,
        "text": "4",
        "origin": [
          149.52760314941406,
          405.3644104003906
        ],
        "bbox": [
          149.52760314941406,
          396.187255859375,
          153.07090759277344,
          407.9651794433594
        ]
      }
    ],
    "requiredNotes": [
      "67:note4"
    ],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:1",
    "publishedBody": "われは誓おう、復活の日にかけて。",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:2",
    "publishedBody": "われは誓おう、自らを咎める魂にかけて。",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:3",
    "publishedBody": "人間は、われらがその骨を再び集めたりはしないと思っているのか。",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:4",
    "publishedBody": "いいや、本当にわれらは、その指先を再びそろえることもできる。",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:5",
    "publishedBody": "いいや、しかし人間は、その先にあるものを否定し[、罪を犯し続け]たがる。",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:6",
    "publishedBody": "そして尋ねる。「復活の日とは、いつになるのか」。",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:7",
    "publishedBody": "やがて目がくらむとき、",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:8",
    "publishedBody": "月はかげり、",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:9",
    "publishedBody": "太陽と月が一緒にされる。",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:10",
    "publishedBody": "その日になって、人間は言う。「どこに逃げればよいのか」。",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:11",
    "publishedBody": "断じて、それはならない。避難するところなどない。",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:12",
    "publishedBody": "その日、居場所はあなたの主にある。",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:13",
    "publishedBody": "その日、人間は自分がすでに行ったこと、後に残してきたことを告げ報せられる。",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:14",
    "publishedBody": "いいや、むしろ人間は、自分自身の目撃者となる、",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:15",
    "publishedBody": "たとえいろいろな言い訳をしようとも。",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:16",
    "publishedBody": "[早く啓示を憶えようとして、]あなたの舌を急いで動かしてはならない。",
    "pages": [
      518
    ],
    "noteAnchors": [
      {
        "page": 518,
        "id": "b62l0s0",
        "direction": [
          1.0,
          0.0
        ],
        "wmode": 0,
        "size": 7.086599826812744,
        "flags": 4,
        "bidi": 0,
        "char_flags": 16,
        "font": "YuMin-Medium",
        "color": 7500145,
        "alpha": 255,
        "ascender": 0.800000011920929,
        "descender": -0.20000000298023224,
        "text": "1 ",
        "origin": [
          246.14300537109375,
          389.4447021484375
        ],
        "bbox": [
          246.14300537109375,
          380.2675476074219,
          252.046142578125,
          392.04547119140625
        ]
      }
    ],
    "requiredNotes": [
      "75:note1"
    ],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:17",
    "publishedBody": "それを集めるのも朗読させるのもわれらのすること。",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:18",
    "publishedBody": "われらがそれを朗読するとき、朗読されたとおり[の読み方]に従いなさい。",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:19",
    "publishedBody": "そののち、それ[の意味]を明らかにするのもわれらのすること。",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:20",
    "publishedBody": "断じて、しかしあなたがた[人間]は刹那[の現世]を愛する。",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:21",
    "publishedBody": "そして来世のことは放っておく。",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:22",
    "publishedBody": "その日、[ある者の]顔は輝き、",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:23",
    "publishedBody": "自分の主を仰ぎ見る。",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:24",
    "publishedBody": "その日、[別の者の]顔は曇り、",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:25",
    "publishedBody": "背骨が折れるほどの惨事のあることを思うだろう。",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
  {
    "key": "75:26",
    "publishedBody": "いや、[人間の魂が]喉元までせり上がるとき、",
    "pages": [
      518
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
    "classification": "published-Quran-translation"
  },
