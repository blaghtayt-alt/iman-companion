  },
  {
    "key": "20:85",
    "publishedBody": "かの御方は告げた。「われらはあなたの[去った]後に、あなたの民を試みた。するとサーミリーが、彼らを迷わせた」。",
    "pages": [
      268
    ],
    "noteAnchors": [],
    "requiredNotes": [],
    "editionId": "ja-tokyo-camii-pdf01_03-2022-02-01",
