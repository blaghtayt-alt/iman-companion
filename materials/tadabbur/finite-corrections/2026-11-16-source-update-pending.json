    "changes": [
      {
        "id": 1,
        "action": "remove",
        "verse": "92:20",
        "before": "وكان معيار العمل: وجه الله لا «الظهير» البشري. ويمكن تلخيص خط السورة كله هنا: في وقت الظلام تحتاج إلى بذل وإخلاص؛ بالبذل تتحرك، وبالإخلاص لا تنحرف أثناء الحركة. فإذا اجتمعا انقشع كثير من الليل من قلبك أولًا، ثم صار لك أثر في إنارة ما حولك.",
        "after": "",
        "unchanged": false
      },
      {
        "id": 2,
        "action": "remove",
        "verse": "74:56",
        "before": "وهكذا تنتهي السورة التي بدأت بـ«قم»: حركة بين خوف يوقظ، ورجاء يمنع الانكسار، وعمل يبذله العبد وهو يعلم أن الهداية والقبول فضل من الله.",
        "after": "",
        "unchanged": false
      },
      {
        "id": 3,
        "action": "remove",
        "verse": "61:14",
        "before": "وهكذا تنتهي السورة بما بدأت تبحث عنه: أحب الأعمال لا يبقى أمنية منطوقة؛ يتحول إلى صف، وبذل، وثبات، وإنسان قرر أن يكون من أنصار الله.",
        "after": "",
        "unchanged": false
      },
      {
        "id": 4,
        "action": "remove",
        "verse": "80:42",
        "before": "وبين البداية والنهاية يظهر محور السورة كله: كيف يحمل الداعية الوحي، وكيف يضبط أولوياته، وكيف يستقبل المقبل، وكيف لا يبيع كرامة الرسالة للمستغني، لأن النتيجة النهائية ليست مكانة الإنسان في الدنيا بل الوجه الذي يلقى به الله.",
        "after": "",
        "unchanged": false
      },
      {
        "id": 5,
        "action": "remove",
        "verse": "70:44",
        "before": "وبين البداية والنهاية قدمت السورة طريقًا آخر: عروج إلى الله، صبر جميل، صلاة دائمة محفوظة، حق للآخرين، تصديق وخشية، عفة وأمانة وشهادة. والخلاصة النفسية للسورة واضحة: إن تركت ضعفك بلا ربّ تحوّل إلى هلع، وإذا ملأت الفراغ بالوحي والعبادة صار ضعفك بابًا للتقوى والعروج.",
        "after": "",
        "unchanged": false
      },
      {
        "id": 6,
        "action": "remove",
        "verse": "35:45",
        "before": "وهكذا ترد الخاتمة القلب إلى من افتتحت السورة بحمده: الخالق القدير، الواسع الرحمة، العليم بالعباد، الذي لا يضيع عنده عمل ولا حق.",
        "after": "",
        "unchanged": false
      },
      {
        "id": 7,
        "action": "remove",
        "verse": "99:8",
        "before": "وهكذا ترد خاتمة السورة أثر الزلزلة إلى سلوك اليوم: لا يحتقر العبد خيرًا يقدر عليه، ولا يستصغر شرًا يزينه له هواه، ويتهيأ لرؤية عمل لم يضع منه شيء.",
        "after": "",
        "unchanged": false
      },
      {
        "id": 8,
        "action": "remove",
        "verse": "7:206",
        "before": "وهكذا تقود السورة من معرفة العداوة والابتلاء إلى معرفة ما يحفظ العبد فيهما: اتباع ما أنزل الله، والاعتصام بولايته، وعبادته من غير استكبار.",
        "after": "",
        "unchanged": false
      },
      {
        "id": 9,
        "action": "remove",
        "verse": "111:5",
        "before": "هذه الوجوه يجمعها معنى واحد: طاقة بُذلت بإصرار في الإفساد، حتى صار الوصف ملازمًا لها. كما كانت تعين زوجها على الصد، يظهر الجزاء بصورة تحمل فيها ما يزيد النار اشتعالًا؛ فيرى القارئ كيف يمكن للإنسان أن يكون عونًا لمن حوله إلى الخير أو عونًا لهم إلى الهلاك.",
        "after": "",
        "unchanged": false
      },
      {
        "id": 10,
        "action": "remove",
        "verse": "111:5",
        "before": "وفي قلب المؤمن الذي يقرأها وقت الضعف رسالة ثبات: قد يتأخر ظهور النتيجة، لكن طريق الله لا يقاس بلحظة القوة الظاهرة لأعدائه.",
        "after": "",
        "unchanged": false
      },
      {
        "id": 11,
        "action": "replace",
        "verse": "86:10",
        "before": "وهكذا ترجع السورة بالمتكبر إلى حجمه الحقيقي: خُلق من ماء دافق، ثم يُبعث، ثم تُكشف سريرته، ثم يقف بلا القوة التي كان يتباهى بها ولا الشبكة التي كان يحتمي بها. لذلك يكون اعتماد القلب من الآن على من لا تزول قوته ولا يخذل عبده.",
        "after": "وهكذا تردّ السورة المتكبر إلى حقيقة ضعفه: خُلق من ماء دافق، ثم يُبعث يوم تُختبر السرائر، فلا يجد قوة يدفع بها عن نفسه، ولا ناصرًا يحتمي به. فالأجدر بالإنسان أن يتوكل منذ الآن على الله، الذي لا تزول قدرته ولا يعجزه شيء.",
        "unchanged": false,
        "authorityNote": "User corrected the intended BEFORE in a subsequent direct message; AFTER unchanged."
      },
      {
        "id": 12,
        "action": "replace",
        "verse": "70:43",
        "before": "هنا تبلغ مفارقة السورة ذروتها: في الدنيا، عندما كان الهلع يصيبهم، يركضون إلى المال والأسباب والآلهة المصنوعة بحثًا عن الأمان؛ وفي الآخرة يركضون بنفس الصورة إلى الموقف الذي لا ينجيهم منه شيء. العجلة بقيت، لكن الاتجاه كان خطأ من البداية. المؤمن يتعلم أن لا يجعل خوفه يدفعه إلى أسفل؛ حين يضطرب يعرج إلى الله بالصلاة بدل أن يوفض إلى «نُصب» جديد.",
        "after": "وهنا تبرز مفارقة لافتة: كانوا في الدنيا، إذا اشتد بهم الخوف، يسارعون إلى المال وما يتعلقون به من أسباب، وإلى ما يعبدون من دون الله، طلبًا للأمان؛ فإذا جاء يوم القيامة خرجوا من الأجداث سراعًا، ﴿كَأَنَّهُمْ إِلَىٰ نُصُبٍ يُوفِضُونَ﴾، ولكنها سرعة لا تنجيهم من أهوال ذلك اليوم. تشابهت صورة الإسراع، لكن ما كانوا يطلبون به الأمان في الدنيا لن ينفعهم في الآخرة. أما المؤمن فيتعلم ألّا يدع الخوف يدفعه إلى التعلق بما لا ينفعه؛ بل إذا اضطرب قلبه لجأ إلى الله بالصلاة، بدلًا من أن يبحث عن الأمان فيما لا يملك له نفعًا ولا ضرًّا بذاته.",
        "unchanged": false
      },
      {
        "id": 13,
        "action": "replace",
        "verse": "99:8",
        "before": "والفارق ليس أن الفاجر لا يعرف قبح الذنب أصلًا؛ فالذباب مستقبح أيضًا، ولكنه يعامل أثره كشيء يزول بإشارة ولا يشغل قلبه، بينما يستحضر المؤمن عظمة من عصى وخطر الوقوف بين يديه. وقد يعرف الإنسان أن كسبًا حرام ثم يهون أمره لما يدر عليه من مال؛ فتظهر حاجته إلى ميزان يرد ما عظمه الهوى إلى قدره الصحيح. ولا يكفي أن يخاف القلب لحظة ثم تبقى الحياة كما كانت؛ فمن تطبيق هذا المعنى أن يضبط المرء وقت استيقاظه على صلاة الفجر لا على عمله وحده، وأن يزن كلمته قبل نشرها، وأن يسأل عن حل كسبه ومطعمه بدل الأخذ بلا مبالاة.",
        "after": "والفارق ليس أن الفاجر يجهل قبح الذنب تمامًا؛ فهو يستقبح الذباب أيضًا، لكنه يراه شيئًا عابرًا يمكن أن يطرده بإشارة، فلا يشغل به قلبه. وكذلك يستخف بالذنب، بينما يستحضر المؤمن عظمة من عصاه وخطورة الوقوف بين يديه. وقد يعلم الإنسان أن مصدرًا من مصادر كسبه حرام، ثم يهوّن على نفسه أمره لما يدرّ عليه من مال؛ وهنا تظهر حاجته إلى ميزان يعيد ما عظّمه الهوى إلى قدره الحقيقي. ولا يكفي أن يخاف القلب لحظة ثم تستمر الحياة كما كانت؛ بل لا بد أن يظهر أثر هذا الخوف في العمل. فمن تطبيق ذلك أن ينظّم المرء وقت استيقاظه بما يعينه على صلاة الفجر، لا وفق متطلبات عمله وحدها، وأن يتروّى قبل نشر كلامه، وأن يتحرّى الحلال في كسبه وطعامه، بدلًا من الأخذ دون مبالاة.",
        "unchanged": false
      }
    ]
  },
