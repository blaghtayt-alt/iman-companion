        ],
        "utf16": [
          22881,
          23149
        ],
        "sha256_utf8": "ab3ffa95a29ae22762629d4e91f2a73605c4cd1242e20512ee68e0c53e91a084"
      }
    ],
    "attached_containers": [
      "S21"
    ],
    "mandatory_adjacent": true
  },
  {
    "note_id": "ES:own:9",
    "whole_text": "La cita con «cuando me llama» se emplea según la narración de Abu Huraira en Muslim. La publicación española la atribuye a Al-Bujari; esa discrepancia se deja registrada. La narración de Anas y la variante sobre el recuerdo permanecen separadas en las fuentes.",
    "whole_note": {
      "cp": [
        0,
        260
      ],
      "utf16": [
        0,
        260
      ],
      "sha256_utf8": "318b01a92b90489c2cdfc9311f860d84c4dbffc3a87f19b2bd810a12b9650ccf"
    },
    "reading_occurrences": [
      {
        "cp": [
