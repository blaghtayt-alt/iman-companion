      "S11"
    ],
    "mandatory_adjacent": true
  },
  {
    "note_id": "ES:own:7",
    "whole_text": "Las menciones de la sal, el forraje y la correa no se presentan aquí como nuevas citas literales. El relato sobre los primeros musulmanes permanece sin atribución a una persona concreta.",
    "whole_note": {
      "cp": [
        0,
        186
      ],
      "utf16": [
        0,
        186
      ],
      "sha256_utf8": "04edccde0c08b3f0d68c441ce7a4f35964f1716303bb474accfe02faf685a89b"
    },
    "reading_occurrences": [
      {
