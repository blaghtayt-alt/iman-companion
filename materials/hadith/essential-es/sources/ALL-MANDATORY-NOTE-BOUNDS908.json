      }
    ],
    "attached_containers": [
      "S5"
    ],
    "mandatory_adjacent": true
  },
  {
    "note_id": "ES:own:4",
    "whole_text": "Traducción propia del significado de las palabras citadas, directamente del árabe. La anciana habla antes; la respuesta final corresponde al Profeta ﷺ. La referencia y las valoraciones atribuidas se conservan en las fuentes.",
    "whole_note": {
      "cp": [
        0,
        224
      ],
      "utf16": [
        0,
        224
      ],
      "sha256_utf8": "9dc5d541bd920deb4e55f5f2c79f535445238d2d3761e3d966957b188090873f"
    },
