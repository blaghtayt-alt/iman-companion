          27546
        ],
        "utf16": [
          27286,
          27546
        ],
        "sha256_utf8": "318b01a92b90489c2cdfc9311f860d84c4dbffc3a87f19b2bd810a12b9650ccf"
      }
    ],
    "attached_containers": [
      "S27"
    ],
    "mandatory_adjacent": true
  },
  {
    "note_id": "ES:own:10",
    "whole_text": "Se conserva la fórmula «se ha transmitido»: las fuentes recogen valoraciones distintas de esta narración, indicadas con su atribución.",
    "whole_note": {
      "cp": [
        0,
        134
      ],
      "utf16": [
        0,
