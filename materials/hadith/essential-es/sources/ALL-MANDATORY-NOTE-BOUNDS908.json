    ],
    "mandatory_adjacent": true
  },
  {
    "note_id": "ES:own:1",
    "whole_text": "Hadiz qudsí: el Profeta ﷺ transmite palabras de su Señor; no es Corán. «Yinn» en la cita designa a los genios. Las citas publicadas conservan su grafía.",
    "whole_note": {
      "cp": [
        0,
        152
      ],
      "utf16": [
        0,
        152
      ],
      "sha256_utf8": "c0f0f7637942663d0711cba375ac1b9eb1098b7eb499f9363da4ca0147ff6eda"
    },
    "reading_occurrences": [
      {
        "cp": [
