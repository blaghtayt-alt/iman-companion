    "mandatory_adjacent": true
  },
  {
    "note_id": "ES:own:13",
    "whole_text": "Se cita la variante de Abu Huraira en Muslim con «La mano derecha». La nota 4 es explicación del editor de esa traducción. El comentario de esta lección se refiere a que los dones de Allah no agotan lo que Él posee.",
    "whole_note": {
      "cp": [
        0,
        215
      ],
      "utf16": [
        0,
        215
      ],
      "sha256_utf8": "c8bf8a67282ed640bae711727a9554c2a87ab36820d0f0f3f2fa47a5419e9d1c"
    },
    "reading_occurrences": [
