      }
    ],
    "attached_containers": [
      "S2"
    ],
    "mandatory_adjacent": true
  },
  {
    "note_id": "ES:own:3",
    "whole_text": "En 67:9, los habitantes del Fuego reconocen que recibieron una advertencia y reproducen las palabras con las que antes la rechazaron.",
