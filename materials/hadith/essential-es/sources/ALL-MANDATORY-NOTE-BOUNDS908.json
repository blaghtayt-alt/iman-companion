      }
    ],
    "attached_containers": [
      "S6"
    ],
    "mandatory_adjacent": true
  },
  {
    "note_id": "ES:own:5",
    "whole_text": "Las palabras del imán Ahmad se ofrecen en traducción propia del significado. Ash-Sham designa la región histórica del Levante.",
    "whole_note": {
      "cp": [
        0,
        126
      ],
      "utf16": [
        0,
        126
      ],
      "sha256_utf8": "d40e98aef5b86f694f60b88b948333889a267be8b7789106ef7cb8f92ba311d8"
    },
