      }
    ],
    "attached_containers": [
      "S15"
    ],
    "mandatory_adjacent": true
  },
  {
    "note_id": "ES:own:8",
    "whole_text": "Explicación propia del traductor: el término árabe en estos dos pasajes se refiere expresamente a la anchura del Paraíso. García expresa aquí su vastedad con «tan vasto». La explicación de este matiz está separada de las citas publicadas, que se mantienen sin cambios.",
    "whole_note": {
      "cp": [
        0,
        268
      ],
      "utf16": [
        0,
        268
      ],
      "sha256_utf8": "ab3ffa95a29ae22762629d4e91f2a73605c4cd1242e20512ee68e0c53e91a084"
    },
    "reading_occurrences": [
      {
