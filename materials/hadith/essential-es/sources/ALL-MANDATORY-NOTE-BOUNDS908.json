        "utf16": [
          1900,
          2052
        ],
        "sha256_utf8": "c0f0f7637942663d0711cba375ac1b9eb1098b7eb499f9363da4ca0147ff6eda"
      }
    ],
    "attached_containers": [
      "main"
    ],
    "mandatory_adjacent": true
  },
  {
    "note_id": "ES:own:2",
    "whole_text": "Las citas coránicas son traducciones publicadas de los significados; algunas son fragmentos. Sus formulaciones, signos y notas se conservan con la atribución y el texto completo en las fuentes que acompañan la lectura.",
    "whole_note": {
      "cp": [
        0,
        218
      ],
      "utf16": [
        0,
        218
      ],
      "sha256_utf8": "e164940e4c3d943683a73d64f530d4948a4ad5cedbe7a12c5413103ec0a639e9"
    },
    "reading_occurrences": [
