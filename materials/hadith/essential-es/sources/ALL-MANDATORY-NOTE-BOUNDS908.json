        ],
        "sha256_utf8": "d40e98aef5b86f694f60b88b948333889a267be8b7789106ef7cb8f92ba311d8"
      }
    ],
    "attached_containers": [
      "S1"
    ],
    "mandatory_adjacent": true
  },
  {
    "note_id": "ES:own:6",
    "whole_text": "La sed y el dar de beber pertenecen a otra narración; no se añaden al texto de Muslim que abre la lección.",
    "whole_note": {
      "cp": [
        0,
        106
      ],
      "utf16": [
        0,
        106
      ],
      "sha256_utf8": "a2e53f8492216c52fc2be1e9bf0ef118b090ba9863ef68378167f70ada502b49"
    },
