  "sourceDocumentSHA256": "898d71da5b11f5c659434f9278c9ab8cdf4b3a2c8c6b82aab03253c747787bc0",
  "introduction": [
    {
      "sourceParagraph": 1,
      "text": "الباب الثامن من النص الجامع للأحاديث",
      "style": "Subtitle",
      "runs": [
        {
          "text": "الباب الثامن من النص الجامع للأحاديث",
          "color": "000000",
          "colorTheme": null,
          "bold": false
        }
      ],
      "hyperlinks": []
    },
    {
      "sourceParagraph": 2,
      "text": "ثلاثون مدخلا في سلامة الصدر وحسن الخلق، تتناول الرحمة والمحبة والنصح والصدق والحياء والعفو والإحسان، وأثرها في صحبة الناس وتربية الأولاد وحمل المسؤولية؛ تجمع الشرح والتأمل والشواهد القرآنية والنبوية في سياق متصل.",
      "style": "",
      "runs": [
        {
          "text": "ثلاثون مدخلا في سلامة الصدر وحسن الخلق، تتناول الرحمة والمحبة والنصح والصدق والحياء والعفو والإحسان، وأثرها في صحبة الناس وتربية الأولاد وحمل المسؤولية؛ تجمع الشرح والتأمل والشواهد القرآنية والنبوية في سياق متصل.",
          "color": "000000",
          "colorTheme": null,
          "bold": false
        }
      ],
      "hyperlinks": []
    },
    {
      "sourceParagraph": 3,
      "text": "يبدأ كل مدخل بنص الرواية ومرجعها، ثم يتبعه شرح متصل يجمع معانيها وشواهدها وروابطها بالآيات والأحاديث الأخرى. وتبقى الروايات المتقاربة مداخل مستقلة حين يختلف لفظها أو وجه دلالتها.",
      "style": "",
      "runs": [
        {
          "text": "يبدأ كل مدخل بنص الرواية ومرجعها، ثم يتبعه شرح متصل يجمع معانيها وشواهدها وروابطها بالآيات والأحاديث الأخرى. وتبقى الروايات المتقاربة مداخل مستقلة حين يختلف لفظها أو وجه دلالتها.",
          "color": "5B626B",
          "colorTheme": null,
          "bold": false
        }
      ],
      "hyperlinks": []
    },
