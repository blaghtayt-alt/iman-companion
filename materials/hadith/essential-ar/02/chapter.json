    {
      "sourceParagraph": 1,
      "text": "الباب الثاني من النص الجامع للأحاديث",
      "style": "Subtitle",
      "runs": [
        {
          "text": "الباب الثاني من النص الجامع للأحاديث",
          "color": "000000",
